root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{asm, cpp, hpp, h, rs}]
indent_size = 4

[/ThirdParty/**]
charset = unset
insert_final_newline = unset
indent_size = unset
indent_style = unset
trim_trailing_whitespace = unset

[CMakeLists.txt]
indent_size = 2

[CMakePresets.json]
indent_size = 4

[Cargo.toml]
indent_size = 4
