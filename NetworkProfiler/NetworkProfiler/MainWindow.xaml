<Window x:Class="NetworkProfiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:NetworkProfiler"
        xmlns:conv="clr-namespace:NetworkProfiler.Converters"
        xmlns:npc="clr-namespace:NetworkProfiler.Core;assembly=NetworkProfiler.Core"
        mc:Ignorable="d"
        d:DesignWidth="1300" d:DesignHeight="800"
        Width="1600" Height="900"
        MinWidth="800" MinHeight="500"
        Title="Milan Network Profiler"
        Closing="Window_Closing">
    <Window.Resources>
        <conv:InversionConverter x:Key="InversionConverter"/>
        <conv:IsNullConverter x:Key="IsNullConverter"/>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <conv:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <conv:InvertedNullVisibilityConverter x:Key="InvertedNullVisibilityConverter"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:InvertedVisibilityConverter x:Key="InvertedVisibilityConverter"/>
        <conv:ControlMessageConverter x:Key="ControlMessageConverter"/>
        <conv:ControlMessageTypeConverter x:Key="ControlMessageTypeConverter"/>
        <conv:RemoteAddressConverter x:Key="RemoteAddressConverter"/>

        <ObjectDataProvider x:Key="ControlTypeEnum" ObjectType="{x:Type sys:Enum}" MethodName="GetValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="npc:ControlMessageType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Start" IsEnabled="{Binding Path=ActiveCapture, Converter={StaticResource IsNullConverter}}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="20" Margin="0,0,0,5"
                               Text="Open a capture database" />

                    <DockPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock  VerticalAlignment="Bottom" Text="Select an .mnpsdb file from your preferred game installation..." Opacity="0.7"/>
                        <Button HorizontalAlignment="Right" Padding="6,2" Command="{Binding OpenFreeCommand}">... or open a file directly</Button>
                    </DockPanel>
                    <ListView x:Name="LocalFilesView" Grid.Row="2" SelectionMode="Single"
                              Visibility="{Binding Path=LocalFilesAvailable, Converter={StaticResource VisibilityConverter}}"
                              ToolTip="Double click on a capture element to begin loading it"
                              ItemsSource="{Binding Path=LocalFiles}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction
                                    Command="{Binding OpenLocalCommand}"
                                    CommandParameter="{Binding ElementName=LocalFilesView, Path=SelectedItem}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontSize="16" Margin="0,0,0,5" Text="{Binding Filename}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last modified: "/>
                                        <TextBlock Text="{Binding Timestamp}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Size (bytes): "/>
                                        <TextBlock Text="{Binding Size}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Refresh list" Command="{Binding RefreshLocalsCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                    <TextBlock Grid.Row="2"
                               Visibility="{Binding Path=LocalFilesAvailable, Converter={StaticResource InvertedVisibilityConverter}}"
                               Text="Set the MILAN_GAME_WIN64 environmental variable!"/>
                </Grid>
            </TabItem>
            <TabItem Header="Summary / chart" IsEnabled="{Binding Path=ActiveCapture, Converter={StaticResource IsNotNullConverter}}">
                <TabItem.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.FocusLogSearchKeybind}" Executed="FocusLogSearchKeybind_Executed"/>
                    <CommandBinding Command="{x:Static local:MainWindow.PreviousFrameKeybind}" Executed="PreviousFrameKeybind_Executed"/>
                    <CommandBinding Command="{x:Static local:MainWindow.NextFrameKeybind}" Executed="NextFrameKeybind_Executed"/>
                </TabItem.CommandBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*" MinHeight="182"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <plot:WpfPlot x:Name="MainPlot" Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" />
                    <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="10,10,0,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0,0,20,5"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel.ToolTip>
                                Statistics with emphasized checkbox labels are presented with dotted lines
                                and use the larger vertical axis on the right.
                            </StackPanel.ToolTip>
                            <CheckBox Content="Actor count" IsChecked="{Binding ChartActorCount}"/>
                            <CheckBox Content="Property count" IsChecked="{Binding ChartPropertyCount}"/>
                            <CheckBox Content="Property size (bytes)" IsChecked="{Binding ChartPropertySize}"/>
                            <CheckBox Content="RPC count" IsChecked="{Binding ChartRemoteCallCount}"/>
                            <CheckBox Content="RPC size (bytes)" IsChecked="{Binding ChartRemoteCallSize}"/>
                            <CheckBox Content="SendBunch count"  IsChecked="{Binding ChartSendBunchCount}"/>
                            <CheckBox Content="SendBunch size (bytes)" IsChecked="{Binding ChartSendBunchSize}" FontStyle="Italic"/>
                            <CheckBox Content="Socket send count" IsChecked="{Binding ChartSocketSendCount}"/>
                            <CheckBox Content="Socket send size (bytes)" IsChecked="{Binding ChartSocketSendSize}" FontStyle="Italic"/>
                            <CheckBox Content="Socket recv count" IsChecked="{Binding ChartSocketRecvCount}"/>
                            <CheckBox Content="Socket recv size (bytes)" IsChecked="{Binding ChartSocketRecvSize}" FontStyle="Italic"/>
                            <CheckBox Content="Control message count" IsChecked="{Binding ChartControlMessageCount}"/>
                            <CheckBox Content="Session events" IsChecked="{Binding ChartSessionEventMarker}"/>
                            <CheckBox Content="Level starts" IsChecked="{Binding ChartLevelStartMarker}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Margin="0,5" Foreground="LightGray" />
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TabControl Grid.Column="0" Grid.RowSpan="2"  Margin="0,0,10,0" TabStripPlacement="Bottom">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Padding" Value="6, 4"/>
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="Global summary">
                                <TextBox VerticalAlignment="Stretch"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="14"
                                         Text="{Binding Path=ActiveCapture.TotalSummary, Mode=OneWay}"/>
                            </TabItem>
                            <TabItem Header="Frame" IsEnabled="{Binding Path=ActiveCapture.CurrentFrame, Converter={StaticResource IsNotNullConverter}}">
                                <TextBox VerticalAlignment="Stretch"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="14"
                                         Text="{Binding Path=ActiveCapture.FrameSummary, Mode=OneWay}"/>
                            </TabItem>
                        </TabControl>
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Stretch"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="14"
                                 Text="{Binding Path=ActiveCapture.CurrentFrame.Log, Mode=OneWay}"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                            <TextBox x:Name="LogSearchTextBox" Padding="2"
                                     Text="{Binding Path=ActiveCapture.LogQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="5,0,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Text="Search frame log by record type or parameter values (excluding low-level calls)..." Opacity="0.6">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LogSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin" Value="0,0,0,5"/>
                            </Style>
                            <Style TargetType="Separator">
                                <Setter Property="Margin" Value="0,0,0,5"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="Sync vertical axes" Command="{Binding SyncAxesCommand}"/>
                        <Button Content="Reset chart" Command="{Binding ResetChartCommand}"/>
                        <Separator/>
                        <Button Content="Freeze frame" Command="{Binding ToggleFreezeFrameCommand}" Visibility="{Binding Path=FrameFreezeEnabled, Converter={StaticResource InvertedVisibilityConverter}, ConverterParameter=true}"/>
                        <Button Content="Unfreeze frame" Command="{Binding ToggleFreezeFrameCommand}" Visibility="{Binding Path=FrameFreezeEnabled, Converter={StaticResource VisibilityConverter}, ConverterParameter=true}"/>
                        <Separator/>
                        <Button Content="First frame" Command="{Binding FirstFrameCommand}"/>
                        <Button Content="Previous frame" Command="{Binding PreviousFrameCommand}"/>
                        <Button Content="Next frame" Command="{Binding NextFrameCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Control messages" IsEnabled="{Binding Path=ActiveCapture, Converter={StaticResource IsNotNullConverter}}">
                <TabItem.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.ControlMessageSearchKeybind}" Executed="ControlMessageSearchKeybind_Executed"/>
                </TabItem.CommandBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="400" Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="ControlMessagesListView"
                              Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" SelectionMode="Single"
                              ItemsSource="{Binding Path=ActiveCapture.ControlMessages}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Frame" Width="40" DisplayMemberBinding="{Binding FrameIndex}"/>
                                <GridViewColumn Header="(ms.)" Width="60" DisplayMemberBinding="{Binding FrameTime, StringFormat=N2}"/>
                                <GridViewColumn Header="Remote" Width="100" DisplayMemberBinding="{Binding Remote}"/>
                                <GridViewColumn Header="Recipient" Width="80" DisplayMemberBinding="{Binding Recipient}"/>
                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding MessageType}"/>
                                <GridViewColumn Header="Params" Width="1000" DisplayMemberBinding="{Binding Params}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,5,5,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Grid.Column" Value="0">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,60,4" />
                                        <!--<Setter Property="FontWeight" Value="SemiBold" />-->
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <Trigger Property="Grid.Column" Value="1">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Remote"/>
                        <ComboBox Grid.Row="0" Grid.Column="1">
                            <ComboBox.Resources>
                                <CollectionViewSource x:Key="Addresses" Source="{Binding Path=ActiveCapture.RemoteAddresses}"/>
                            </ComboBox.Resources>
                            <ComboBox.SelectedItem>
                                <MultiBinding Converter="{StaticResource RemoteAddressConverter}"
                                              Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="ActiveCapture.ControlMessageFilter.Remote"/>
                                    <Binding RelativeSource="{RelativeSource Self}" Path="."/>
                                </MultiBinding>
                            </ComboBox.SelectedItem>
                            <ComboBox.ItemsSource>
                                <CompositeCollection>
                                    <ComboBoxItem IsSelected="True">ANY</ComboBoxItem>
                                    <CollectionContainer Collection="{Binding Source={StaticResource Addresses}}"/>
                                </CompositeCollection>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Message type"/>
                        <ComboBox Grid.Row="1" Grid.Column="1">
                            <ComboBox.SelectedItem>
                                <MultiBinding Converter="{StaticResource ControlMessageTypeConverter}"
                                              Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="ActiveCapture.ControlMessageFilter.MessageType"/>
                                    <Binding RelativeSource="{RelativeSource Self}" Path="."/>
                                </MultiBinding>
                            </ComboBox.SelectedItem>
                            <ComboBox.ItemsSource>
                                <CompositeCollection>
                                    <ComboBoxItem IsSelected="True">ANY</ComboBoxItem>
                                    <CollectionContainer Collection="{Binding Source={StaticResource ControlTypeEnum}}"/>
                                </CompositeCollection>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <TextBox x:Name="ControlMessageSearchTextBox"
                                 Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Padding="2"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding Path=ActiveCapture.ControlMessageFilter.ParamQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="5,4,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Text="Search control messages by params text..." Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ControlMessageSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="78" Margin="0,5,0,0"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="14"
                             Text="{Binding ElementName=ControlMessagesListView, Path=SelectedValue,
                                Converter={StaticResource ControlMessageConverter}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Actors / properties" IsEnabled="{Binding Path=ActiveCapture, Converter={StaticResource IsNotNullConverter}}">
                <TabItem.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.ReplicatedActorSearchKeybind}" Executed="ReplicatedActorSearchKeybind_Executed"/>
                </TabItem.CommandBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="ReplicatedActorsListView"
                              Grid.Row="0" Grid.Column="0" SelectionMode="Single"
                              ItemsSource="{Binding Path=ActiveCapture.ReplicatedActors}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Total bytes" Width="80" DisplayMemberBinding="{Binding AccumBytes, StringFormat=N2}"/>
                                <GridViewColumn Header="Count" Width="80" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="(Non empty)" Width="80" DisplayMemberBinding="{Binding NonEmptyCount}"/>
                                <GridViewColumn Header="Avg bytes" Width="80" DisplayMemberBinding="{Binding AvgBytes, StringFormat=N1}"/>
                                <GridViewColumn Header="Avg bits" Width="80" DisplayMemberBinding="{Binding AvgBits, StringFormat=N1}"/>
                                <GridViewColumn Header="Actor class" Width="380" DisplayMemberBinding="{Binding ActorName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="0" Grid.Column="1" Width="2" Margin="5"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Background="LightGray"/>
                    <ListView Grid.Row="0" Grid.Column="2" SelectionMode="Single"
                              ItemsSource="{Binding ElementName=ReplicatedActorsListView, Path=SelectedValue.Properties}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Total bytes" Width="80" DisplayMemberBinding="{Binding AccumBytes, StringFormat=N2}"/>
                                <GridViewColumn Header="Count" Width="80" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="Avg bytes" Width="80" DisplayMemberBinding="{Binding AvgBytes, StringFormat=N1}"/>
                                <GridViewColumn Header="Avg bits" Width="80" DisplayMemberBinding="{Binding AvgBits, StringFormat=N1}"/>
                                <GridViewColumn Header="Property name" Width="380" DisplayMemberBinding="{Binding PropertyName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Grid>
                            <TextBox x:Name="ReplicatedActorSearchTextBox"
                                     MinWidth="395" Margin="0,10,0,0" Padding="2" HorizontalAlignment="Left" 
                                     Text="{Binding Path=ActiveCapture.ActorReplicationFilter.ClassQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock MinWidth="395" Margin="5,10,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="Search replicated actor classes by name..." Opacity="0.6">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ReplicatedActorSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Foreground="Red" VerticalAlignment="Center" Margin="10,10,0,2">
                            Note that average size for actors is only calculated for non-empty actor sends.
                            Average property sizes are counted normally.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Remote calls" IsEnabled="{Binding Path=ActiveCapture, Converter={StaticResource IsNotNullConverter}}">
                <TabItem.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.RemoteCallSearchKeybind}" Executed="RemoteCallSearchKeybind_Executed"/>
                </TabItem.CommandBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" Grid.Column="0" SelectionMode="Single"
                              ItemsSource="{Binding Path=ActiveCapture.RemoteCalls}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Total bytes" Width="80" DisplayMemberBinding="{Binding AccumBytes, StringFormat=N2}"/>
                                <GridViewColumn Header="Count" Width="80" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="Avg bytes" Width="80" DisplayMemberBinding="{Binding AvgBytes, StringFormat=N1}"/>
                                <GridViewColumn Header="Avg bits" Width="80" DisplayMemberBinding="{Binding AvgBits, StringFormat=N1}"/>
                                <GridViewColumn Header="Path" Width="380" DisplayMemberBinding="{Binding JointName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBox x:Name="RemoteCallSearchTextBox"
                             Grid.Row="1" MinWidth="395" Margin="0,10,0,0" Padding="2" HorizontalAlignment="Left" 
                             Text="{Binding Path=ActiveCapture.RemoteCallFilter.RemoteCallQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" MinWidth="395" Margin="5,10,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="Search remote calls by object or function name..." Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=RemoteCallSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="0" Width="60" Height="22" Margin="10, 5"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Visibility="{Binding Path=ActiveCapture, Converter={StaticResource NullVisibilityConverter}}"
                Command="{Binding CloseCommand}">Close</Button>
        <StatusBar Grid.Row="1" Padding="5, 0">
            <StatusBarItem>
                <TextBlock x:Name="CurrentStatus" Text="Hello there"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
