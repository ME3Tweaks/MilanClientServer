<Window x:Class="NetworkProfiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:NetworkProfiler"
        xmlns:conv="clr-namespace:NetworkProfiler.Converters"
        mc:Ignorable="d"
        Title="Milan Network Profiler" Height="800" Width="1400">
    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Start">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="20" Margin="0,0,0,10"
                               Text="Open a capture database" />

                    <DockPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Select an .mnpsdb file from your preferred game installation..." Opacity="0.7"/>
                        <Button HorizontalAlignment="Right" Padding="6,2" Command="{Binding OpenFreeCommand}">... or open a file directly.</Button>
                    </DockPanel>
                    <ListView x:Name="LocalFilesView" Grid.Row="2" SelectionMode="Single"
                              Visibility="{Binding Path=LocalFilesAvailable, Converter={StaticResource VisibilityConverter}}"
                              ItemsSource="{Binding Path=LocalFiles}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction
                                    Command="{Binding OpenLocalCommand}"
                                    CommandParameter="{Binding ElementName=LocalFilesView, Path=SelectedItem}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontSize="16" Margin="0,0,0,5" Text="{Binding Filename}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last modified: "/>
                                        <TextBlock Text="{Binding Timestamp}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Size (bytes): "/>
                                        <TextBlock Text="{Binding Size}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Refresh list" Command="{Binding RefreshLocalsCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                    <TextBlock Grid.Row="2" Visibility="{Binding Path=LocalFilesHint, Converter={StaticResource VisibilityConverter}}"
                               Text="Set the MILAN_GAME_WIN64 environmental variable!"/>
                </Grid>
            </TabItem>
            <TabItem Header="Summary chart" IsEnabled="False"/>
            <TabItem Header="Detailed log" IsEnabled="False"/>
            <TabItem Header="Actors and properties" IsEnabled="False"/>
            <TabItem Header="RPC" IsEnabled="False"/>
        </TabControl>
        <StatusBar Grid.Row="1" Padding="5, 0">
            <StatusBarItem>
                <TextBlock x:Name="CurrentStatus" Text="Hello there"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
