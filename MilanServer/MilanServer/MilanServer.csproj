<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keeps the container image small. Also turns on the trim analyzers for every build. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MilanServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- config/milan.json is a local, live-reloaded file, never part of the build or image. -->
    <Content Remove="config\**" />
  </ItemGroup>
</Project>
