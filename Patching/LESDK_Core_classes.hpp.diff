+inline UPackage* UObject::GetOutermost()
+{
+    UObject* Outermost = this;
+    for (; Outermost && Outermost->Outer; Outermost = Outermost->Outer);
+    return Outermost->Cast<UPackage>();
+}
 
+inline UPackage const* UObject::GetOutermost() const
+{
+    UObject const* Outermost = this;
+    for (; Outermost && Outermost->Outer; Outermost = Outermost->Outer);
+    return Outermost->Cast<UPackage>();
